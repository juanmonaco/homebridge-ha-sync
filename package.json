{
  "name": "homebridge-ha-sync",
  "version": "0.1.0",
  "description": "Bidirectional Homebridge ↔ Home Assistant state sync plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand",
    "lint": "eslint \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "home-assistant",
    "blinds",
    "window-covering"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "homebridge": ">=1.6.0"
  },
  "dependencies": {
    "axios": "1.20.0",
    "tail": "2.2.6"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.5.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "fast-check": "4.10.0",
    "homebridge": "2.4.0",
    "jest": "30.5.1",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/__tests__/**"
    ]
  }
}
